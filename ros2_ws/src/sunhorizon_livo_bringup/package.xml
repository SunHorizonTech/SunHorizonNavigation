<?xml version="1.0"?>
<package format="3">
  <name>sunhorizon_livo_bringup</name>
  <version>0.1.0</version>
  <description>Fail-closed Robot A FAST-LIVO2 process, offline mapping, and odometry adapter.</description>
  <maintainer email="46861254+dongchany@users.noreply.github.com">SunHorizon Navigation</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>libpcl-all-dev</depend>
  <depend>nav_msgs</depend>
  <depend>nlohmann_json</depend>
  <depend>openssl</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>sunhorizon_navigation_interfaces</depend>
  <depend>sunhorizon_navigation_core</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
